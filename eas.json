{
  "cli": {
    "version": ">= 18.0.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1"
      },
      "android": {
        "resourceClass": "medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "aab",
        "resourceClass": "large"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccount": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
